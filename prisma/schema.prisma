generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// USUÁRIOS E AUTENTICAÇÃO (NextAuth + Verificação)
// ----------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("USER") // USER, ADMIN
  bio           String?
  targetGoal    String?   @default("HIPERTROFIA") // HIPERTROFIA, EMAGRECIMENTO, FORCA, CONDICIONAMENTO
  height        Float?    // em cm
  currentWeight Float?    // em kg
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  workouts           Workout[]
  workoutLogs        WorkoutLog[]
  progressPhotos     ProgressPhoto[]
  weightRecords      WeightRecord[]
  chatMessages       ChatMessage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // email do usuário
  token      String   @unique
  type       String   @default("EMAIL_VERIFICATION") // EMAIL_VERIFICATION, RESET_PASSWORD
  expires    DateTime
  createdAt  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ----------------------------------------------------
// TREINOS E EXERCÍCIOS (Rotinas e Fichas)
// ----------------------------------------------------

model Workout {
  id           String   @id @default(cuid())
  userId       String
  name         String   // Ex: "Treino A - Peito e Tríceps"
  type         String   @default("MUSCULAÇÃO") // MUSCULAÇÃO, CARDIO, FUNCIONAL, CALISTENIA, CROSSFIT
  description  String?
  dayOfWeek    String?  // SEGUNDA, TERCA, QUARTA, QUINTA, SEXTA, SABADO, DOMINGO, FLEXIVEL
  muscleGroups String?  // "Peitoral, Tríceps, Ombros"
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  workoutLogs WorkoutLog[]

  @@map("workouts")
}

model Exercise {
  id          String   @id @default(cuid())
  workoutId   String
  name        String   // Ex: "Supino Inclinado com Halteres"
  muscleGroup String?  // Ex: "Peitoral Superior"
  sets        Int      @default(4)
  reps        String   @default("8-12")
  weight      Float    @default(0) // Carga atual de referência (kg)
  restSeconds Int      @default(90) // Tempo de descanso em segundos
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workout      Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]

  @@map("exercises")
}

// ----------------------------------------------------
// REGISTRO DE EXECUÇÃO E EVOLUÇÃO DE CARGA
// ----------------------------------------------------

model WorkoutLog {
  id              String   @id @default(cuid())
  userId          String
  workoutId       String?
  workoutName     String   // Cópia do nome do treino para manter histórico mesmo se deletar
  date            DateTime @default(now())
  durationMinutes Int?     // Duração em minutos
  perceivedEffort Int?     // Percepção de esforço 1 a 10 (RPE)
  notes           String?
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout      Workout?      @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  exerciseLogs ExerciseLog[]

  @@map("workout_logs")
}

model ExerciseLog {
  id           String   @id @default(cuid())
  workoutLogId String
  exerciseId   String?
  exerciseName String
  setsData     String   @db.Text // JSON string: [{"set": 1, "reps": 12, "weight": 70}, ...]
  maxWeight    Float    @default(0) // Carga máxima alcançada no exercício hoje
  totalVolume  Float    @default(0) // Volume = sum(peso * reps)
  notes        String?
  createdAt    DateTime @default(now())

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise   Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@map("exercise_logs")
}

// ----------------------------------------------------
// FOTOS DE PROGRESSO E RECORDAÇÃO
// ----------------------------------------------------

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  imageUrl  String   // Caminho da foto salvo no volume EasyPanel da VPS
  date      DateTime @default(now())
  weight    Float?   // Peso registrado no dia da foto
  pose      String   @default("FRENTE") // FRENTE, COSTAS, LATERAL, LIVRE
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_photos")
}

model WeightRecord {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  bodyFat   Float?   // Percentual de gordura corporal opcional
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weight_records")
}

// ----------------------------------------------------
// CHATBOT IA (Nine Router VPS)
// ----------------------------------------------------

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  role        String   // "user", "assistant", "system"
  content     String   @db.Text
  contextType String?  // "TREINO_DIARIO", "PLANO_SEMANAL", "DISCIPLINA", "NUTRIÇÃO"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
